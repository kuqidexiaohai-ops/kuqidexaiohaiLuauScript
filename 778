		local skins = collectSkinEntries(knife.name, attr and attr[knife.name], FALLBACK_KNIVES[knife.name])
		for _, s in ipairs(skins) do
			table.insert(list, {
				kind = "knife", name = s.name, label = knife.name .. " | " .. s.name,
				id = isSaber and nil or (s.id or knife.icon),
				isDefault = false, usesViewport = isSaber,
				knife = knife.name, skin = s.name, wear = "Factory New",
			})
		end
		Catalog.KnifeEntries[knife.name] = list
	end

	do
		GloveTypeOrder = discoverGloveTypes()
		for _, gtype in ipairs(GloveTypeOrder) do
			local list = {}
			local skins = collectSkinEntries(gtype, attr and attr[gtype], FALLBACK_GLOVES[gtype], SKIP_GLOVE_SKINS)
			local root = getAssetsRoot()
			local folder = root and findChildCI(root, gtype) or nil
			local hasDefault = folder and (findChildCI(folder, "Stock") or findChildCI(folder, "Vanilla"))
			if hasDefault then
				table.insert(list, {
