getgenv().C4Probe = function()
	local hits = 0
	local function walk(root, depth)
		if not root then
			return
		end
		for _, c in ipairs(root:GetChildren()) do
			if (c:IsA("Model") or c:IsA("BasePart")) and appIsC4Name(c.Name) then
				hits += 1
				print(("[C4] %s  [%s]"):format(c:GetFullName(), c.ClassName))
				if c:IsA("BasePart") then
					print(("      T=%.2f mat=%s"):format(c.Transparency, tostring(c.Material)))
				end
				for _, d in ipairs(c:GetDescendants()) do
					if d:IsA("BasePart") then
						print(("      %s [%s] T=%.2f mat=%s"):format(
							d.Name, d.ClassName, d.Transparency, tostring(d.Material)))
					end
				end
			elseif depth < 2 and (c:IsA("Folder") or c:IsA("Model")) then
				walk(c, depth + 1)
			end
		end
	end
	walk(workspace, 0)
	walk(workspace.CurrentCamera, 0)
	print(("[C4] 命中 %d 个模型/部件；若为 0，把 C4 的正确名字发我"):format(hits))
end

appRevert()

