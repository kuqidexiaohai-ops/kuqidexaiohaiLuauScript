local function findModule(name, preferPath)
	local node = RS
	if preferPath then
		for _, seg in ipairs(preferPath) do
			node = node and node:FindFirstChild(seg)
		end
	end
	if node and node:IsA("ModuleScript") then return node end
	for _, inst in ipairs(RS:GetDescendants()) do
		if inst:IsA("ModuleScript") and inst.Name == name then
			return inst
		end
	end
	return nil
end

