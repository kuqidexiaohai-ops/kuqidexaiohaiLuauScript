applySkin = function(entry)
	local cfg = getgenv().SkinConfig
	local changed = false
	local isGunDefault = false
	if entry.kind == "knife" then
		cfg.DK, cfg.DS, cfg.DW = entry.knife, entry.skin or "", entry.wear or "Factory New"
		changed = true
	elseif entry.kind == "gun" then
		cfg.GunSkins = cfg.GunSkins or {}
		if entry.skin == "" then
			cfg.GunSkins[entry.weapon] = nil
			isGunDefault = true
		else
			cfg.GunSkins[entry.weapon] = entry.skin
		end
		cfg.GunWear = entry.wear or "Factory New"
		changed = true
	elseif entry.kind == "glove" then
		cfg.GG, cfg.GS, cfg.GW = entry.gloveType, entry.skin or "", entry.wear or "Factory New"
		changed = true
	end
	if not changed then return end
	if not HooksInstalled and SkinApplier.tryInstall() then
		Library:Notify("皮肤钩子已自动重装", 3)
	end
	updatePreviewBig({ icon = entry.id, label = entry.label, entry = entry, slot = makeSlot(entry), usesViewport = entry.usesViewport })
	renderGrid()
	refreshAppliedThumbs()
	if entry.kind == "glove" then
		GloveEngine.RebuildSoon()
		Library:Notify(("已应用：%s\n手套即时生效"):format(entry.label), 4)
	elseif isGunDefault then
		Library:Notify(("已恢复 %s 默认外观\n切枪 / 重生后生效"):format(entry.weapon or "武器"), 4)
	else
		Library:Notify(("已应用：%s\n请切成其他武器再切回来（或重生）以重建模型"):format(entry.label), 5)
	end
end

