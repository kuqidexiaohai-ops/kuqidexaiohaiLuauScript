--// ======================== 6.8 透明外观替换（本机） ========================
do -- ★ 分节包裹

local FORCEFIELD = Enum.Material.ForceField
local WHITE = Color3.fromRGB(255, 255, 255)

local APP = getgenv().AppearanceState
if type(APP) ~= "table" then
	APP = {}
	getgenv().AppearanceState = APP
end

for _, g in ipairs({ "Gun", "Arm", "Sleeve", "Char", "C4" }) do
	if APP[g .. "Alpha"] ~= nil then
		APP[g .. "T"] = 1 - APP[g .. "Alpha"]
		APP[g .. "Alpha"] = nil
	end
end

for _, dead in ipairs({
	"GunMat", "ArmMat", "SleeveMat", "CharMat", "C4Mat",
	"CuffOn", "CuffKeysRaw", "CuffKeys", "HideCustom", "HideKeysRaw", "HideKeys",
}) do
	APP[dead] = nil
end

local function appColorEq(a, b)
	return typeof(a) == "Color3"
		and math.abs(a.R - b.R) < 0.01
		and math.abs(a.G - b.G) < 0.01
		and math.abs(a.B - b.B) < 0.01
end
for key, old in pairs({
	GunColor = Color3.fromRGB(249, 233, 153),
	ArmColor = Color3.fromRGB(249, 233, 153),
	CharColor = Color3.fromRGB(249, 233, 153),
	SleeveColor = Color3.fromRGB(216, 211, 204),
	C4Color = Color3.fromRGB(249, 233, 153),
}) do
	if appColorEq(APP[key], old) then
		APP[key] = WHITE
	end
end

for k, v in pairs({
	GunOn = false, GunColor = WHITE, GunT = 0,
	ArmOn = false, ArmColor = WHITE,
	SleeveOn = false, SleeveColor = WHITE,
	CharOn = false, CharColor = WHITE, CharT = 0,
	C4On = false, C4Color = WHITE, C4T = 0,
	HideGun = false, HideArm = false, HideGlove = false, HideCuff = false,
}) do
	if APP[k] == nil then
		APP[k] = v
	end
end

local CUFF_KEYS = { "sleeve", "cuff", "wrist", "collar" }

local DATA = getgenv().AppearanceData
if type(DATA) ~= "table" then
	DATA = {}
	getgenv().AppearanceData = DATA
end

local HLDATA = getgenv().AppearanceHighlightData
if type(HLDATA) ~= "table" then
	HLDATA = {}
	getgenv().AppearanceHighlightData = HLDATA
end

local SKIP_NAMES = {
	ViewmodelLight = true, Hitbox = true, HumanoidRootPart = true,
	Camera = true, CameraPart = true,
}
local SKIP_FOLDERS = {
	AnimatedParts = true, Interactables = true,
}

local function appBlocked(part, model)
	if SKIP_NAMES[part.Name] then
		return true
	end
	local p = part.Parent
	local guard = 0
	while p and p ~= model and guard < 8 do
		if SKIP_FOLDERS[p.Name] then
			return true
		end
		p = p.Parent
		guard += 1
	end
	return false
end

local function appLocalCharacter()
	local c = LP.Character
	if c and c.Parent then
		return c
	end
	local chars = workspace:FindFirstChild("Characters")
	return chars and chars:FindFirstChild(LP.Name) or nil
end

local function appPark(part, d, inst)
	if not d.stripped then
		d.stripped = {}
	end
	d.stripped[#d.stripped + 1] = { inst = inst, parent = part }
	inst.Parent = nil
end

local function appStrip(part, d)
	if d.stripped == nil then
		d.stripped = {}
	end
	for _, c in ipairs(part:GetChildren()) do
		if c:IsA("SurfaceAppearance") or c:IsA("Texture") or c:IsA("Decal") then
			appPark(part, d, c)
		end
	end
end

local function appWant(d, tt)
	if tt == nil then
		return math.clamp(d.transp, 0, 1)
	end
	tt = math.clamp(tonumber(tt) or 0, 0, 1)
	return math.clamp(d.transp + (1 - d.transp) * tt, 0, 1)
end

local function appEnforce(part, d)
	if not d or not d.mode or not part.Parent then
		return
	end
	local sa = part:FindFirstChildOfClass("SurfaceAppearance")
	if sa then
		appPark(part, d, sa)
	end
	local wantT = (d.mode == "hide") and 1 or d.wantT
	if math.abs(part.Transparency - wantT) > 0.01 then
		pcall(function()
			part.Transparency = wantT
		end)
	end
	if d.mode == "style" then
		if part.Material ~= FORCEFIELD then
			pcall(function()
				part.Material = FORCEFIELD
			end)
		end
		if d.setColor and part.Color ~= d.setColor then
			pcall(function()
				part.Color = d.setColor
			end)
		end
	end
end

local function appHook(part, d)
	if d.conn then
		return
	end
	pcall(function()
		d.conn = part:GetPropertyChangedSignal("Transparency"):Connect(function()
			if d.mode then
				appEnforce(part, d)
			end
		end)
	end)
end

local function appStyle(part, model, mode, color, tt, ignoreFolders)
	if not part:IsA("BasePart") then
		return true
	end
	if SKIP_NAMES[part.Name] then
		return true
	end
	if not ignoreFolders and appBlocked(part, model) then
		return true
	end
	local d = DATA[part]
	if not d then
		if part.Transparency > 0.01 then
			return false
		end
		d = {
			mat = part.Material,
			color = part.Color,
			transp = part.Transparency,
		}
		DATA[part] = d
	end
	appStrip(part, d)
	d.mode = mode
	d.setColor = color
	d.wantT = appWant(d, tt)
	appHook(part, d)
	appEnforce(part, d)
	return true
end

local function appRestore(part)
	local d = DATA[part]
	if not d then
		return
	end
	if d.conn then
		pcall(function()
			d.conn:Disconnect()
		end)
		d.conn = nil
	end
	d.mode = nil
	pcall(function()
		part.Material = d.mat
		part.Color = d.color
		part.Transparency = d.transp
	end)
	if d.stripped then
		for _, s in ipairs(d.stripped) do
			pcall(function()
				if s.inst and s.parent and s.parent.Parent then
					s.inst.Parent = s.parent
				end
			end)
		end
		d.stripped = nil
	end
end

-- ★ v22 观战用：把记录全部还原并清空（清空后下次扫描会按当前状态重新快照，安全）
local spectateMode = false
local function appHardReset()
	if getgenv().AppearanceEnforce then
		pcall(getgenv().AppearanceEnforce, false)
	end
	for part in pairs(DATA) do
		appRestore(part)
	end
	for part in pairs(DATA) do
		DATA[part] = nil
	end
	for hl, rec in pairs(HLDATA) do
		pcall(function()
			if hl.Parent then
				hl.FillTransparency = rec.fill
				hl.OutlineTransparency = rec.outline
			end
		end)
		HLDATA[hl] = nil
	end
end

local function appIsCuff(part)
	local hay = (part.Name or ""):lower()
	local n = part.Parent
	local guard = 0
	while n and guard < 6 do
		if n:IsA("Model") then
			break
		end
		hay = hay .. "/" .. (n.Name or ""):lower()
		n = n.Parent
		guard += 1
	end
	for _, k in ipairs(CUFF_KEYS) do
		if hay:find(k, 1, true) then
			return true
		end
	end
	return false
end

local function appCollect(model)
	local list, seen = {}, {}
	local function push(p, kind)
		if p:IsA("BasePart") and not seen[p] then
			seen[p] = true
			list[#list + 1] = { part = p, kind = kind }
		end
	end
	local weapon = model:FindFirstChild("Weapon")
	if weapon then
		push(weapon, "gun")
		for _, d in ipairs(weapon:GetDescendants()) do
			push(d, "gun")
		end
	end
	for _, armName in ipairs({ "Left Arm", "Right Arm" }) do
		local arm = model:FindFirstChild(armName)
		if arm and arm:IsA("BasePart") then
			local glove = arm:FindFirstChild("Glove")
			if glove then
				push(glove, "glove")
				for _, d in ipairs(glove:GetDescendants()) do
					push(d, "glove")
				end
			end
			push(arm, "arm")
			for _, d in ipairs(arm:GetDescendants()) do
				if d:IsA("BasePart") and not (glove and d:IsDescendantOf(glove)) then
					push(d, "arm")
				end
			end
		end
	end
	local dummies = model:FindFirstChild("DummyParts")
	if dummies then
		for _, d in ipairs(dummies:GetDescendants()) do
			if d:IsA("MeshPart") and d.Transparency < 0.5 then
				push(d, "arm")
			end
		end
	end
	return list
end

local function appIsC4Name(name)
	return tostring(name or ""):lower():find("c4", 1, true) ~= nil
end

local function appCollectC4()
	local list, seen = {}, {}
	local function pushPart(p)
		if p:IsA("BasePart") and not seen[p] and p.Transparency < 0.99 then
			seen[p] = true
			list[#list + 1] = p
		end
	end
	local function isLimb(root, p)
		local n = p
		while n and n ~= root do
			local nm = n.Name
			if nm == "Left Arm" or nm == "Right Arm" or nm == "Glove" then
				return true
			end
			n = n.Parent
		end
		return false
	end
	local function scanModel(m)
		if isLimb(m, m) then
			return
		end
		pushPart(m)
		for _, d in ipairs(m:GetDescendants()) do
			if not isLimb(m, d) then
				pushPart(d)
			end
		end
	end
	local function scanContainer(container)
		if not container then
			return
		end
		for _, c in ipairs(container:GetChildren()) do
			if (c:IsA("Model") or c:IsA("BasePart")) and appIsC4Name(c.Name) then
				scanModel(c)
			elseif c:IsA("Folder") and appIsC4Name(c.Name) then
				for _, k in ipairs(c:GetChildren()) do
					if k:IsA("Model") or k:IsA("BasePart") then
						scanModel(k)
					end
				end
			end
		end
	end
	scanContainer(workspace.CurrentCamera)
	scanContainer(workspace)
	scanContainer(workspace:FindFirstChild("Debris"))
	return list
end

local function appMuteHighlight(model, on)
	local hl = model:FindFirstChild("ViewmodelHighlight")
	if not hl or not hl:IsA("Highlight") then
		return
	end
	if on then
		if not HLDATA[hl] then
			HLDATA[hl] = { fill = hl.FillTransparency, outline = hl.OutlineTransparency }
		end
		if hl.FillTransparency < 1 then
			pcall(function()
				hl.FillTransparency = 1
			end)
		end
	elseif HLDATA[hl] then
		local rec = HLDATA[hl]
		pcall(function()
			hl.FillTransparency = rec.fill
			hl.OutlineTransparency = rec.outline
		end)
		HLDATA[hl] = nil
	end
end

local function appHighlightEnforce()
	for hl in pairs(HLDATA) do
		if hl.Parent then
			if hl.FillTransparency < 1 then
				pcall(function()
					hl.FillTransparency = 1
				end)
			end
		else
			HLDATA[hl] = nil
		end
	end
end

local function appApplyModel(model)
	local pending = 0
	local targets = appCollect(model)
	local inTarget = {}
	for _, t in ipairs(targets) do
		inTarget[t.part] = true
	end

	for _, t in ipairs(targets) do
		local p, kind = t.part, t.kind
		if not appBlocked(p, model) then
			local mode, color, tt
			if kind == "gun" then
				if APP.HideGun then
					mode = "hide"
				elseif APP.GunOn then
					mode, color = "style", APP.GunColor
				end
			else
				local hide = (kind == "glove" and APP.HideGlove)
					or (kind == "arm" and APP.HideArm)
					or (APP.HideCuff and appIsCuff(p))
				if hide then
					mode = "hide"
				elseif kind == "glove" and APP.SleeveOn then
					mode, color = "style", APP.SleeveColor
				elseif kind == "arm" and APP.ArmOn then
					mode, color = "style", APP.ArmColor
				end
			end
			if mode then
				if not appStyle(p, model, mode, color, tt) then
					pending += 1
				end
			else
				appRestore(p)
			end
		end
	end

	for part in pairs(DATA) do
		if part.Parent and part:IsDescendantOf(model) and not inTarget[part] then
			appRestore(part)
		end
	end

	appMuteHighlight(model, APP.GunOn or APP.ArmOn or APP.SleeveOn)

	return pending
end

local function appApplyC4()
	local pending = 0
	for _, p in ipairs(appCollectC4()) do
		if APP.C4On then
			if not appStyle(p, nil, "style", APP.C4Color, nil, true) then
				pending += 1
			end
		else
			appRestore(p)
		end
	end
	return pending
end

local function appApplyCharacter()
	local pending = 0
	local char = appLocalCharacter()
	if not char then
		return pending
	end
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			if APP.CharOn then
				if not appStyle(p, char, "style", APP.CharColor, APP.CharT) then
					pending += 1
				end
			else
				appRestore(p)
			end
		end
	end
	return pending
end

local function appScan()
	-- ★ v22 观战期间不写任何外观（否则会去抢被观战者 viewmodel 的材质 → 别人切刀时闪）
	if isSpectating() then
		return 0
	end
	local pending = 0
	local cam = workspace.CurrentCamera
	if cam then
		for _, m in ipairs(cam:GetChildren()) do
			if m:IsA("Model") then
				pending += appApplyModel(m)
			end
		end
	end
	pending += appApplyCharacter()
	pending += appApplyC4()
	return pending
end

local function appRevert()
	for part in pairs(DATA) do
		appRestore(part)
	end
end

getgenv().AppearanceCleanup = function()
	APP.GunOn, APP.ArmOn, APP.SleeveOn, APP.CharOn, APP.C4On = false, false, false, false, false
	APP.HideGun, APP.HideArm, APP.HideGlove, APP.HideCuff = false, false, false, false
	if getgenv().AppearanceEnforce then
		getgenv().AppearanceEnforce(false)
	end
	appRevert()
	for hl, rec in pairs(HLDATA) do
		pcall(function()
			if hl.Parent then
				hl.FillTransparency = rec.fill
				hl.OutlineTransparency = rec.outline
			end
		end)
		HLDATA[hl] = nil
	end
end

local function appAnyOn()
	return APP.GunOn or APP.ArmOn or APP.SleeveOn or APP.CharOn or APP.C4On
		or APP.HideGun or APP.HideArm or APP.HideGlove or APP.HideCuff
end

local ENFORCE_BIND = "BeautifyAppearanceEnforce"
pcall(function()
	RunService:UnbindFromRenderStep(ENFORCE_BIND)
end)

local enforceBound = false
local function appSetEnforce(on)
	if on and not enforceBound then
		enforceBound = true
		pcall(function()
			RunService:BindToRenderStep(ENFORCE_BIND, Enum.RenderPriority.Last.Value, function()
				if spectateMode then
					return -- ★ v22 观战期间不写
				end
				for part, d in pairs(DATA) do
					if d.mode then
						appEnforce(part, d)
					end
				end
				appHighlightEnforce()
			end)
		end)
	elseif not on and enforceBound then
		enforceBound = false
		pcall(function()
			RunService:UnbindFromRenderStep(ENFORCE_BIND)
		end)
	end
end
getgenv().AppearanceEnforce = appSetEnforce

local scanQueued = false
local pendingLoop = false

local function appRetryLoop()
	if pendingLoop then
		return
	end
	pendingLoop = true
	task.spawn(function()
		local waited = 0
		while waited < 3 do
			task.wait(0.1)
			waited += 0.1
			if Library.Unloaded then
				break
			end
			if appScan() == 0 then
				break
			end
		end
		pendingLoop = false
	end)
end

local function appRequestScan()
	if scanQueued then
		return
	end
	scanQueued = true
	task.defer(function()
		scanQueued = false
		appSetEnforce(appAnyOn())
		if appScan() > 0 then
			appRetryLoop()
		end
	end)
end

