local function getGloveOverride()
	local cfg = getgenv().SkinConfig
	if type(cfg) ~= "table" or not getgenv().SkinReplaceEnabled then return nil end
	local gtype = cfg.GG
	if type(gtype) ~= "string" or gtype == "" then return nil end
