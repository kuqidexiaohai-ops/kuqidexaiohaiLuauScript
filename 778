local lightSaberSource = nil
local function getLightSaberModel()
	if lightSaberSource and lightSaberSource.Parent then
		return lightSaberSource
	end
	lightSaberSource = nil
	local assets = RS:FindFirstChild("Assets")
	local weapons = assets and assets:FindFirstChild("Weapons")
	if not weapons then return nil end
	local saber = findChildCI(weapons, "LightSaber")
	if not saber then return nil end
	local camModel = findChildCI(saber, "Camera")
	local weapon = camModel and findChildCI(camModel, "Weapon")
	lightSaberSource = weapon or camModel or saber
	return lightSaberSource
end

local function boundsOf(inst)
	local parts = {}
	if inst:IsA("BasePart") then table.insert(parts, inst) end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then table.insert(parts, d) end
	end
	if #parts == 0 then return nil end
	local mn, mx
	for _, p in ipairs(parts) do
		local h = p.Size / 2
		local a, b = p.Position - h, p.Position + h
		if mn then
			mn = Vector3.new(math.min(mn.X, a.X), math.min(mn.Y, a.Y), math.min(mn.Z, a.Z))
			mx = Vector3.new(math.max(mx.X, b.X), math.max(mx.Y, b.Y), math.max(mx.Z, b.Z))
		else
			mn, mx = a, b
		end
	end
	return CFrame.new((mn + mx) / 2), (mx - mn)
end

local function createSaberViewport(parentFrame, position, size)
	local source = getLightSaberModel()
	if not source then return nil end
	local ok, frame = pcall(function()
		local vp = Instance.new("ViewportFrame")
		vp.BackgroundTransparency = 1
		vp.Ambient = Color3.fromRGB(255, 255, 255)
		vp.LightColor = Color3.fromRGB(255, 255, 255)
		vp.LightDirection = Vector3.new(-0.4, -1, -0.35).Unit
		vp.ZIndex = 6
		vp.Position = position
		vp.Size = size

		local clone = source:Clone()
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("LuaSourceContainer") or d:IsA("Camera") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Anchored = true
			end
		end
		clone.Parent = vp

		local cf, sz = boundsOf(clone)
		if not cf then error("模型没有部件") end
		local radius = math.max(sz.Magnitude, 2)
		local cam = Instance.new("Camera")
		cam.FieldOfView = 45
		cam.Parent = vp
		vp.CurrentCamera = cam
		local offset = Vector3.new(0.8, 0.45, 1).Unit * radius * 0.85
		cam.CFrame = CFrame.lookAt(cf.Position + offset, cf.Position)
		return vp
	end)
	if not ok or not frame then return nil end
	frame.Parent = parentFrame
	return frame
end

--== 图片预热器 ==
local imageRefs = {}
local warmRunning, warmQueued = false, false

local function registerImage(lbl, id)
	if type(id) ~= "string" or id == "" or not id:match("^rbxasset") then return end
	local list = imageRefs[id]
	if not list then
		list = {}
		imageRefs[id] = list
	end
	for i = #list, 1, -1 do
		if not list[i] or not list[i].Parent then table.remove(list, i) end
	end
	table.insert(list, lbl)
end

local function warmImages()
	if warmRunning then
		warmQueued = true
		return
	end
	warmRunning = true
	task.spawn(function()
		local ContentProvider = game:GetService("ContentProvider")
		repeat
			warmQueued = false
			local ids = {}
			for id in pairs(imageRefs) do
				table.insert(ids, id)
			end
			local failCount = 0
			for i = 1, #ids, 24 do
				local batch = {}
				for j = i, math.min(i + 23, #ids) do
					table.insert(batch, ids[j])
				end
				local failed = {}
				pcall(function()
					ContentProvider:PreloadAsync(batch, function(contentId, status)
						if status ~= Enum.AssetFetchStatus.Success then
							table.insert(failed, contentId)
						end
					end)
				end)
				for _, id in ipairs(failed) do
					failCount += 1
					for _, lbl in ipairs(imageRefs[id] or {}) do
						pcall(function()
							if lbl.Parent then
								lbl.Image = ""
								task.delay(0.3, function()
									pcall(function()
										if lbl.Parent then lbl.Image = id end
									end)
								end)
							end
						end)
					end
				end
				task.wait(0.05)
			end
			if failCount > 0 then
				warn(("[美化菜单] %d 张图片首载失败，已自动重试"):format(failCount))
			end
		until not warmQueued
		warmRunning = false
	end)
end

local function knifeIconByName(name)
	for _, k in ipairs(KNIVES) do
		if k.name == name then return k.icon end
	end
	return nil
end

local function collectApplied()
	local list = {}
	local cfg = getgenv().SkinConfig
	if type(cfg) ~= "table" then return list end

	if KNIFE_NAME_SET[cfg.DK] then
		local dskin = type(cfg.DS) == "string" and cfg.DS or ""
		for _, e in ipairs(Catalog.KnifeEntries[cfg.DK] or {}) do
			if (e.skin or "") == dskin then
				table.insert(list, { icon = e.id, label = e.label, entry = e, slot = makeSlot(e), usesViewport = e.usesViewport })
				break
			end
		end
	end

	if type(cfg.GG) == "string" and cfg.GG ~= "" then
		local gskin = type(cfg.GS) == "string" and cfg.GS or ""
		local found
		for _, e in ipairs(Catalog.GloveTypeEntries[cfg.GG] or {}) do
			if (e.skin or "") == gskin then
				found = e
				break
			end
		end
		if found then
			table.insert(list, { icon = found.id, label = found.label, entry = found, slot = makeSlot(found) })
		else
			local label = cfg.GG .. ((gskin ~= "") and (" | " .. gskin) or " | 默认")
			local synth = {
				kind = "glove", name = (gskin ~= "") and gskin or "默认", label = label,
				id = GLOVE_ICON, gloveType = cfg.GG, skin = gskin, wear = "Factory New",
			}
			table.insert(list, { icon = synth.id, label = synth.label, entry = synth, slot = makeSlot(synth) })
		end
	end

	local gunItems = {}
	for weaponName, skinName in pairs(cfg.GunSkins or {}) do
		if type(skinName) == "string" and skinName ~= "" then
			local foundEntry
			for _, entries in pairs(Catalog.GunEntries) do
				for _, e in ipairs(entries) do
					if e.weapon == weaponName and e.skin == skinName then
						foundEntry = e
						break
					end
				end
				if foundEntry then break end
			end
			if foundEntry then
				table.insert(gunItems, { icon = foundEntry.id, label = foundEntry.label, entry = foundEntry, slot = makeSlot(foundEntry) })
			else
				local catIcon
				for _, cat in ipairs(CATEGORIES) do
					if cat.weapon == weaponName then
						catIcon = cat.icon
						break
					end
				end
				local synth = { kind = "gun", name = skinName, label = weaponName .. " | " .. skinName, id = catIcon or "", weapon = weaponName, skin = skinName, wear = "Factory New" }
				table.insert(gunItems, { icon = synth.id, label = synth.label, entry = synth, slot = makeSlot(synth) })
			end
		end
	end
	table.sort(gunItems, function(a, b) return a.label < b.label end)
	for _, item in ipairs(gunItems) do
		table.insert(list, item)
	end

	return list
end

