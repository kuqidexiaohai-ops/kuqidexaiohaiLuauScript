local knifeSkinCache = {}

local function resolveKnifeSkin(knifeName, prefer)
	local root = getAssetsRoot()
	local kf = root and findChildCI(root, knifeName) or nil
	if kf then
		if type(prefer) == "string" and prefer ~= "" then
			local sf = findChildCI(kf, prefer)
			if sf then return sf.Name end
		end
		local cached = knifeSkinCache[knifeName]
		if cached and findChildCI(kf, cached) then return cached end
		for _, s in ipairs({ KNIFE_DEFAULT_SKIN[knifeName], "Vanilla", "Stock" }) do
			if type(s) == "string" then
				local sf = findChildCI(kf, s)
				if sf then
					knifeSkinCache[knifeName] = sf.Name
					return sf.Name
				end
			end
		end
		for _, c in ipairs(kf:GetChildren()) do
			local n = c.Name
			if n ~= "Terrorists" and n ~= "Counter-Terrorists" and n ~= "Camera" then
				knifeSkinCache[knifeName] = n
				return n
			end
		end
	end
	if type(prefer) == "string" and prefer ~= "" then return prefer end
	return KNIFE_DEFAULT_SKIN[knifeName] or "Vanilla"
end

