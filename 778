local function normId(id)
	id = tostring(id)
	if id:match("^%d+$") then
		return "rbxassetid://" .. id
	end
	return id
end

local function makeSlot(entry)
	if entry.kind == "gun" then
		return { kind = "gun", weapon = entry.weapon }
	end
	return { kind = entry.kind }
end

local function getAssetsRoot()
	if AssetsRoot and AssetsRoot.Parent then
		return AssetsRoot
	end
	local assets = RS:FindFirstChild("Assets")
	AssetsRoot = assets and assets:FindFirstChild("Skins")
	return AssetsRoot
end

local function reloadAttrData()
	AttrData = nil
	local ok, data = pcall(function()
		local raw = RS:GetAttribute("AvaiableSkins")
		if type(raw) == "string" and raw ~= "" then
			return HttpService:JSONDecode(raw)
		end
	end)
	if ok and type(data) == "table" then
		AttrData = data
	end
	return AttrData ~= nil
end

local function findChildCI(parent, name)
	if not parent or type(name) ~= "string" then
		return nil
	end
	local direct = parent:FindFirstChild(name)
	if direct then
		return direct
	end
	local target = name:lower()
	for _, c in ipairs(parent:GetChildren()) do
		if c.Name:lower() == target then
			return c
		end
	end
	return nil
end

local function collectSkinEntries(weaponName, attrTable, fallbackList, skipNames)
	local root = getAssetsRoot()
	local folder = root and findChildCI(root, weaponName) or nil
	local out, seen = {}, {}

	local function push(rawName, id)
		local name = tostring(rawName)
		if name == "" then return end
		local key = name:lower()
		if seen[key] then return end
		seen[key] = true
		local canonical = name
		if folder then
			local sf = findChildCI(folder, name)
			if sf then
				canonical = sf.Name
			end
		end
		table.insert(out, { name = canonical, id = id })
	end

	local attrUsed = type(attrTable) == "table" and next(attrTable) ~= nil
	if attrUsed then
		for name, data in pairs(attrTable) do
			if type(data) == "table" and data.isEnabled ~= false then
				local id
				if type(data.wearImages) == "table" and data.wearImages[1] then
					id = data.wearImages[1].assetId
				end
				id = id or data.imageAssetId
				push(name, id and normId(id) or nil)
			end
		end
	end

	if folder then
		for _, c in ipairs(folder:GetChildren()) do
			local n = c.Name
			if n ~= "Terrorists" and n ~= "Counter-Terrorists" and n ~= "Camera" then
				push(n, nil)
			end
		end
	end

	if not attrUsed and #out == 0 then
		for _, s in ipairs(fallbackList or {}) do
			push(s[1], s[2] and normId(s[2]) or nil)
		end
	end

	local final = {}
	for _, e in ipairs(out) do
		local okSkin = true
		if folder then
			okSkin = findChildCI(folder, e.name) ~= nil
		end
		if okSkin and skipNames and skipNames[e.name:lower()] then
			okSkin = false
		end
		if okSkin then
			table.insert(final, e)
		end
	end
	table.sort(final, function(a, b)
		return a.name:lower() < b.name:lower()
	end)
	return final
end

local function discoverGloveTypes()
	local set = {}
	for _, g in ipairs(GLOVE_TYPES) do
		set[g] = true
	end
	local root = getAssetsRoot()
	if root then
		for _, c in ipairs(root:GetChildren()) do
			local n = c.Name
			if n ~= "Gloves" and not GLOVE_TYPE_EXCLUDE[n] and (n:find("Glove") or n == "Hand Wraps") then
				set[n] = true
			end
		end
	end
	if type(AttrData) == "table" then
		for k in pairs(AttrData) do
			if type(k) == "string" and k ~= "Gloves" and not GLOVE_TYPE_EXCLUDE[k]
				and (k:find("Glove") or k == "Hand Wraps") then
				set[k] = true
			end
		end
	end
	local out = {}
	for n in pairs(set) do
		table.insert(out, n)
	end
	table.sort(out, function(a, b)
		return a:lower() < b:lower()
	end)
	return out
end

