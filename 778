local function isEntryActive(entry)
	local cfg = getgenv().SkinConfig
	if not entry or type(cfg) ~= "table" then return false end
	if entry.kind == "knife" then
		return cfg.DK == entry.knife and (cfg.DS or "") == (entry.skin or "")
	elseif entry.kind == "gun" then
		return (cfg.GunSkins or {})[entry.weapon] == entry.skin
	elseif entry.kind == "glove" then
		return cfg.GG == entry.gloveType and (cfg.GS or "") == (entry.skin or "")
	end
	return false
end

local function makeCard(cardDef, order)
	local entry = cardDef.entry
	local isMenu = cardDef.type == "menu"
	local isDefault = cardDef.isDefault or (entry and entry.isDefault) or false
	local useViewport = cardDef.usesViewport or (entry and entry.usesViewport) or false
	local active = (not isMenu) and isEntryActive(entry) or false

	local btn = Library:Create("TextButton", {
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = Library.MainColor,
		BorderColor3 = active and Library.AccentColor or Color3.new(0, 0, 0),
		BorderSizePixel = 1,
		LayoutOrder = order,
		ZIndex = 5,
		Parent = skinGrid.holder,
	})
	Library:AddToRegistry(btn, {
		BackgroundColor3 = "MainColor",
		BorderColor3 = active and "AccentColor" or "Black",
	})

	local function setBorder(colorKey, colorValue)
		btn.BorderColor3 = colorValue
		local reg = Library.RegistryMap[btn]
		if reg then reg.Properties.BorderColor3 = colorKey end
	end

	btn.MouseEnter:Connect(function() setBorder("AccentColor", Library.AccentColor) end)
	btn.MouseLeave:Connect(function()
		if active then
			setBorder("AccentColor", Library.AccentColor)
		else
			setBorder("Black", Color3.new(0, 0, 0))
		end
	end)

	local imgId = cardDef.image
	if (type(imgId) ~= "string" or imgId == "") and entry and type(entry.id) == "string" and entry.id ~= "" then
		imgId = entry.id
	end
	if (type(imgId) ~= "string" or imgId == "") and useViewport then
		imgId = KNIFE_GROUP_ICON
	end

	local contentShown = false
	if useViewport then
		contentShown = createSaberViewport(btn, UDim2.fromOffset(3, 3), UDim2.new(1, -6, 1, -19)) ~= nil
	end
	if not contentShown and type(imgId) == "string" and imgId ~= "" then
		local img = Library:Create("ImageLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(3, 3),
			Size = UDim2.new(1, -6, 1, -19),
			ScaleType = Enum.ScaleType.Fit,
			Image = imgId,
			ZIndex = 6,
			Parent = btn,
		})
		registerImage(img, imgId)
		contentShown = true
	end
	if not contentShown and isDefault then
		local t = Library:Create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(3, 3),
			Size = UDim2.new(1, -6, 1, -19),
			Font = Library.Font,
			TextSize = 15,
			Text = "默认",
			TextColor3 = Color3.new(1, 1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = 6,
			Parent = btn,
		})
		Library:AddToRegistry(t, { TextColor3 = "FontColor" })
		pcall(function() Library:ApplyTextStroke(t) end)
	end

	local nameLabel = Library:Create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 2, 1, -14),
		Size = UDim2.new(1, -4, 0, 12),
		Font = Library.Font,
		TextSize = 10,
		Text = cardDef.label or "",
		TextColor3 = Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 6,
		Parent = btn,
	})
	Library:AddToRegistry(nameLabel, { TextColor3 = "FontColor" })
	pcall(function() Library:ApplyTextStroke(nameLabel) end)

	if isMenu then
		Library:Create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(1, -14, 0, 0),
			Size = UDim2.fromOffset(12, 12),
			Font = Library.Font,
			TextSize = 14,
			Text = "›",
			TextColor3 = Color3.new(1, 1, 1),
			ZIndex = 6,
			Parent = btn,
		})
	end

	btn.MouseButton1Click:Connect(function()
		if isMenu then
			cardDef.open()
		else
			applySkin(entry)
		end
	end)
end

