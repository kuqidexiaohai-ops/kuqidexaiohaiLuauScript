local function callForeign(orig, ...)
	foreignScope += 1
	local results = table.pack(pcall(orig, ...))
	foreignScope -= 1
	if not results[1] then
		error(results[2] ~= nil and results[2] or "工厂调用出错", 0)
	end
	return table.unpack(results, 2, results.n)
end

local function makeCameraModelWrapper(orig)
	return function(weaponName, skinName, ...)
		local extra = table.pack(...)
		local ctx = detectOwnerContext(table.unpack(extra, 1, extra.n))
		if ctx == "foreign" or foreignScope > 0 then
			dbg("CameraModel", weaponName, skinName, ctx or "scope", false)
			return callForeign(orig, weaponName, skinName, table.unpack(extra, 1, extra.n))
		end
		local function callOrig(name, skin)
			return orig(name, skin, table.unpack(extra, 1, extra.n))
		end
		local model
		local overridden = false
		if isKnifeName(weaponName) then
			local knifeName, knifeSkin, wear = getKnifeOverride()
			if knifeName then
				local ok, res = pcall(callOrig, knifeName, knifeSkin)
				if ok and res then
					model = res
					overridden = true
					task.defer(patchWeaponModel, model, knifeName, knifeSkin, wear)
				end
			end
			if not model then model = callOrig(weaponName, skinName) end
		else
			local gunSkin, wear = getGunOverride(weaponName)
			if gunSkin then
				local ok, res = pcall(callOrig, weaponName, gunSkin)
				if ok and res then
					model = res
					overridden = true
					task.defer(patchWeaponModel, model, weaponName, gunSkin, wear)
				end
			end
			if not model then model = callOrig(weaponName, skinName) end
		end
		dbg("CameraModel", weaponName, skinName, ctx, overridden)
		return model
	end
end

