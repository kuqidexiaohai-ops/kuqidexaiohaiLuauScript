local function buildGloveModel(gtype, gskin)
	if GloveEngine.Probing then return nil end
	local lib = lazyRequireSkins()
	if not lib then return nil end
	local fn = GloveEngine.OrigGetGloves or lib.GetGloves
	if type(fn) ~= "function" then return nil end
	GloveEngine.Probing = true
	local ok, model = pcall(fn, gtype, gskin, 0.001)
	GloveEngine.Probing = false
	if ok and model then return model end
	return nil
end

local function gloveCandidates(gtype, prefer)
	local out = {}
	local function add(s)
		if type(s) == "string" and s ~= "" and not table.find(out, s) then
			table.insert(out, s)
		end
	end
	add(prefer)
	add("Stock")
	add("Vanilla")
	local root = getAssetsRoot()
	local tf = root and findChildCI(root, gtype)
	if tf then
		for _, c in ipairs(tf:GetChildren()) do
			local n = c.Name
			if not n:find("PATTERN") and n ~= "Terrorists" and n ~= "Counter-Terrorists" then
				add(n)
			end
		end
	end
	return out
end

local function resolveGloveBuild(gtype, prefer)
	if type(gtype) ~= "string" or gtype == "" then return nil end
	local key = gtype .. "|" .. tostring(prefer)
	local cached = gloveSkinCache[key]
	if cached then
		local model = buildGloveModel(gtype, cached)
		if model then return model, cached end
		gloveSkinCache[key] = nil
	end
	for _, skin in ipairs(gloveCandidates(gtype, prefer)) do
		local model = buildGloveModel(gtype, skin)
		if model then
			gloveSkinCache[key] = skin
			return model, skin
		end
	end
	return nil
end

function GloveEngine.Rebuild()
	local lib = lazyRequireSkins()
	if not (lib and type(lib.GetGloves) == "function") then
		GloveEngine.Available = false
		return false
	end
	local ld = getActiveLoadout()
	if not ld then
		GloveEngine.Available = false
		return false
	end
	local vm = ld.CurrentEquipped and ld.CurrentEquipped.Viewmodel
	if not vm then return false end
	local item = getGloveItem(ld)

	local gtype, gskin = getGloveOverride()
	local targetType, prefer
	if gtype then
		targetType = gtype
		prefer = (gskin ~= "" and gskin) or nil
	else
		targetType = (item and item.Name) or ((LP:GetAttribute("Team") == "Terrorists") and "T Glove" or "CT Glove")
		prefer = (item and item.Skin) or nil
	end

	local built = resolveGloveBuild(targetType, prefer)
	if not built then return false end

	local ok = pcall(function()
		if vm.Model then built.Parent = vm.Model end
		if vm.Gloves then pcall(function() vm.Gloves:Destroy() end) end
		vm.Gloves = built
	end)
	if not ok then
		pcall(function() built:Destroy() end)
		return false
	end
	GloveEngine.Available = true
	return true
end

function GloveEngine.RebuildSoon()
	task.defer(function()
		pcall(GloveEngine.Rebuild)
		task.wait(0.1)
		pcall(GloveEngine.Rebuild)
	end)
end

local function makeGlovesWrapper(orig)
	return function(name, skin, float, ...)
		local extra = table.pack(...)
		local function callOrig(n, s, f)
			return orig(n, s, type(f) == "number" and f or 0.001, table.unpack(extra, 1, extra.n))
		end
		local gtype, gskin = getGloveOverride()
		if not gtype then return callOrig(name, skin, float) end
		local built = resolveGloveBuild(gtype, (gskin ~= "" and gskin) or nil)
		if built then return built end
		return callOrig(name, skin, float)
	end
end

local function migrateLegacy()
	local lib = lazyRequireSkins()
	if not lib then return end
	local legacy = {
		{ "GetCameraModel", "SkinLibOrig" },
		{ "GetBaseWeaponModel", "SkinBaseOrig" },
		{ "GetCharacterModel", "SkinCharOrig" },
	}
	for _, item in ipairs(legacy) do
		local saved = getgenv()[item[2]]
		if type(saved) == "function" and lib[item[1]] ~= saved then
			pcall(function() lib[item[1]] = saved end)
		end
		getgenv()[item[2]] = nil
	end
end

-- SkinApplier 已在块外声明
function SkinApplier.tryInstall()
	if HooksInstalled then return true end
	local lib = lazyRequireSkins()
	if not lib then
		SkinApplier.Reason = "未找到 Skins 库"
		return false
	end

	restorePreviousSessionHooks()
	migrateLegacy()
	removeAllHooks()

	addHook(lib, "GetCameraModel", makeCameraModelWrapper)
	addHook(lib, "GetBaseWeaponModel", makeBaseWeaponWrapper)
	addHook(lib, "GetCharacterModel", makeCharacterModelWrapper)

	GloveEngine.OrigGetGloves = lib.GetGloves
	addHook(lib, "GetGloves", makeGlovesWrapper)

	local vmModule = findModule("Viewmodel", { "Classes", "WeaponComponent", "Classes", "Viewmodel" })
	if vmModule then
		local ok, vm = pcall(require, vmModule)
		if ok and type(vm) == "table" then
			addHook(vm, "new", makeViewmodelNewWrapper)
		end
	end

	HooksInstalled = true
	return true
end

