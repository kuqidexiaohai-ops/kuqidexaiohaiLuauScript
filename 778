do -- ★ 分节包裹

local VMState = getgenv().ViewModelState
if type(VMState) ~= "table" then
	VMState = {}
	getgenv().ViewModelState = VMState
end
for k, dv in pairs({ Enabled = false, X = 0.05, Y = -0.27, Z = -0.15, Roll = 0 }) do
	if VMState[k] == nil then VMState[k] = dv end
end

local VMOrig = getgenv().ViewModelOrig
if type(VMOrig) ~= "table" then
	VMOrig = setmetatable({}, { __mode = "k" })
	getgenv().ViewModelOrig = VMOrig
end

local function vmParts(model)
	local s = model and model:FindFirstChild("Stats")
	local d = s and s:FindFirstChild("Default")
	local r = s and s:FindFirstChild("Rotation")
	if d and r and d:IsA("Vector3Value") and r:IsA("Vector3Value") then
		return d, r
	end
	return nil
end

local function vmSnapshot(model)
	if not model or not model:IsA("Model") or VMOrig[model] then return end
	local d, r = vmParts(model)
	if not d then return end
	VMOrig[model] = { default = d.Value, rotation = r.Value }
end

local function vmApply(model)
	local orig = model and VMOrig[model]
	if not orig then return end
	local d, r = vmParts(model)
	if not d then return end
	d.Value = Vector3.new(VMState.X, VMState.Y, VMState.Z)
	r.Value = Vector3.new(orig.rotation.X, orig.rotation.Y, math.rad(VMState.Roll))
end

local function vmScan()
	local cam = workspace.CurrentCamera
	if not cam then return end
	for _, m in ipairs(cam:GetChildren()) do
		vmSnapshot(m)
		if VMState.Enabled then vmApply(m) end
	end
end

local function vmRevert()
	for mdl, orig in pairs(VMOrig) do
		pcall(function()
			if mdl and mdl.Parent then
				local d, r = vmParts(mdl)
				if d then
					d.Value = orig.default
					r.Value = orig.rotation
				end
			end
		end)
	end
end

VMState.Enabled = false
vmRevert()

local vmConn = nil

local function vmInstall()
	local cam = workspace.CurrentCamera
	if not cam then return false end
	if not vmConn then
		vmConn = cam.ChildAdded:Connect(function(m)
			task.defer(function()
				vmSnapshot(m)
				if VMState.Enabled then vmApply(m) end
			end)
		end)
	end
	vmScan()
	return true
end

getgenv().ViewModelCleanup = function()
	VMState.Enabled = false
	if vmConn then
		vmConn:Disconnect()
		vmConn = nil
	end
	vmRevert()
end

task.spawn(function()
	vmInstall()
	while task.wait(1) do
		if Library.Unloaded then return end
		if not vmConn then vmInstall() end
		vmScan()
	end
end)

