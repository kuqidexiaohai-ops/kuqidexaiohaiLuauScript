--// ======================== 6.12 世界 · 天空盒（本机） ========================
-- 探测结论：游戏用的是标准 Sky 实例，名为 "Realistic Clouds"
--   SkyboxBk/Dn/Ft/Lf/Rt/Up + SunTextureId / MoonTextureId / StarCount /
--   SunAngularSize / MoonAngularSize / CelestialBodiesShown
-- 换天空盒 = 直接改这 6 张贴图 + 日月参数，无需自建穹顶
-- 原始值快照在 getgenv().SkyOrig，重贴会先还原；我们自己新建的 Sky 会销毁，游戏原有的只还原数值
do

local Lighting = game:GetService("Lighting")
local SKY_FACES = { "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }

local SK = getgenv().SkyState
if type(SK) ~= "table" then
	SK = {}
	getgenv().SkyState = SK
end
for k, v in pairs({
	On = false,
	StarCount = 3000,
	Celestial = true,
	SunOn = false, SunId = "", SunSize = 6,
	MoonOn = false, MoonId = "", MoonSize = 2,
}) do
	if SK[k] == nil then
		SK[k] = v
	end
end
for _, f in ipairs(SKY_FACES) do
	if SK[f] == nil then
		SK[f] = ""
	end
end

-- ---------- 原始值：只快照一次；重贴先还原 ----------
local SkyOrig = getgenv().SkyOrig
if type(SkyOrig) ~= "table" then
	local s = Lighting:FindFirstChildOfClass("Sky")
	SkyOrig = { Existed = s ~= nil, Created = false, Faces = {} }
	for _, f in ipairs(SKY_FACES) do
		SkyOrig.Faces[f] = s and s[f] or ""
	end
	SkyOrig.StarCount = s and s.StarCount or 3000
	SkyOrig.CelestialBodiesShown = s and s.CelestialBodiesShown or true
	SkyOrig.SunTextureId = s and s.SunTextureId or ""
	SkyOrig.MoonTextureId = s and s.MoonTextureId or ""
	SkyOrig.SunAngularSize = s and s.SunAngularSize or 0
	SkyOrig.MoonAngularSize = s and s.MoonAngularSize or 0
	getgenv().SkyOrig = SkyOrig
end

local function skyRestoreOrig()
	local s = Lighting:FindFirstChildOfClass("Sky")
	if s then
		for _, f in ipairs(SKY_FACES) do
			if SkyOrig.Faces[f] ~= "" then
				pcall(function() s[f] = SkyOrig.Faces[f] end)
			end
		end
		pcall(function()
			s.StarCount = SkyOrig.StarCount
			s.CelestialBodiesShown = SkyOrig.CelestialBodiesShown
			s.SunTextureId = SkyOrig.SunTextureId
			s.MoonTextureId = SkyOrig.MoonTextureId
			s.SunAngularSize = SkyOrig.SunAngularSize
			s.MoonAngularSize = SkyOrig.MoonAngularSize
		end)
	end
	if SkyOrig.Created and not SkyOrig.Existed then
		local x = Lighting:FindFirstChildOfClass("Sky")
		if x then
			pcall(function() x:Destroy() end)
		end
		SkyOrig.Created = false
	end
end

skyRestoreOrig()

SK.On, SK.SunOn, SK.MoonOn = false, false, false

local function skyGet(create)
	local s = Lighting:FindFirstChildOfClass("Sky")
	if s then
		return s
	end
	if not create then
		return nil
	end
	local ok, ns = pcall(function()
		local n = Instance.new("Sky")
		n.Name = "BeautifySky"
		n.Parent = Lighting
		return n
	end)
	if ok and ns then
		SkyOrig.Created = true
		return ns
	end
	return nil
end

local function skyAnyOn()
	return SK.On or SK.SunOn or SK.MoonOn
end

local function skyApply()
	pcall(function()
		skyRestoreOrig()
		if not skyAnyOn() then
			return
		end
		local s = skyGet(true)
		if not s then
			return
		end
		if SK.On then
			for _, f in ipairs(SKY_FACES) do
				local id = SK[f]
				if type(id) == "string" and id ~= "" then
					s[f] = id
				end
			end
			s.StarCount = math.floor(math.clamp(SK.StarCount, 0, 20000))
		end
		s.CelestialBodiesShown = SK.Celestial
		if SK.SunOn then
			if SK.SunId ~= "" then
				s.SunTextureId = SK.SunId
			end
			s.SunAngularSize = SK.SunSize
		end
		if SK.MoonOn then
			if SK.MoonId ~= "" then
				s.MoonTextureId = SK.MoonId
			end
			s.MoonAngularSize = SK.MoonSize
		end
	end)
end

getgenv().SkyCleanup = function()
	SK.On, SK.SunOn, SK.MoonOn = false, false, false
	skyRestoreOrig()
end

getgenv().SkyReport = function()
	local s = Lighting:FindFirstChildOfClass("Sky")
	if not s then
		print("[天空盒] 当前没有 Sky 实例")
		return
	end
	print(("[天空盒] %s | StarCount=%d Celestial=%s Sun=%.1f Moon=%.1f"):format(
		s.Name, s.StarCount, tostring(s.CelestialBodiesShown), s.SunAngularSize, s.MoonAngularSize))
	print(("[天空盒] Bk=%s Dn=%s Ft=%s Lf=%s Rt=%s Up=%s"):format(
		s.SkyboxBk, s.SkyboxDn, s.SkyboxFt, s.SkyboxLf, s.SkyboxRt, s.SkyboxUp))
	print(("[天空盒] Sun=%s Moon=%s | 原始: Bk=%s StarCount=%d"):format(
		s.SunTextureId, s.MoonTextureId, SkyOrig.Faces.SkyboxBk, SkyOrig.StarCount))
end

getgenv().SkyProbe = function()
	local out = {}
	local function P(s)
		out[#out + 1] = s
	end
	P("=== Lighting 子实例 ===")
	for _, c in ipairs(Lighting:GetChildren()) do
		P(("  %s [%s]"):format(c.Name, c.ClassName))
	end
	local s = Lighting:FindFirstChildOfClass("Sky")
	if s then
		P("=== 当前 Sky ===")
		for _, f in ipairs(SKY_FACES) do
			P(("  %s = %s"):format(f, s[f]))
		end
		P(("  Sun=%s Moon=%s StarCount=%d SunAngular=%s MoonAngular=%s"):format(
			s.SunTextureId, s.MoonTextureId, s.StarCount,
			tostring(s.SunAngularSize), tostring(s.MoonAngularSize)))
	end
	P("=== RS.Assets.Lighting（游戏自带光照 / 天空资源）===")
	local assets = RS:FindFirstChild("Assets")
	local ln = assets and assets:FindFirstChild("Lighting")
	if not ln then
		P("  （没有 Assets.Lighting）")
	else
		local function rec(inst, d)
			if d > 3 then
				return
			end
			local ind = string.rep("  ", d)
			local extra = ""
			for _, pn in ipairs({ "Texture", "TextureId", "Image", "SkyboxBk", "SkyboxUp" }) do
				local ok, v = pcall(function()
					return inst[pn]
				end)
				if ok and type(v) == "string" and v ~= "" then
					extra = "  " .. pn .. "=" .. v
					break
				end
			end
			P(("%s%s [%s]%s"):format(ind, inst.Name, inst.ClassName, extra))
			for _, c in ipairs(inst:GetChildren()) do
				rec(c, d + 1)
			end
		end
		for _, c in ipairs(ln:GetChildren()) do
			rec(c, 0)
		end
	end
	local text = table.concat(out, "\n")
	print(text)
	if type(setclipboard) == "function" then
		pcall(setclipboard, text)
		print("[天空盒] 已复制到剪贴板")
	end
end

