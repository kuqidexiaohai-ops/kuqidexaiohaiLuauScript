--// ======================== 6.11 第三人称手持模型（本机） ========================
-- 探测结论（Dex/RemoteSpy 实测）：
--   * 游戏把角色武器挂在 workspace.Debris.<玩家名>_Weapon.Weapon，
--     用 Motor6D 焊到 RightHand；每把枪的 C0 都不同（不能写死）
--   * Character.WeaponModel / WeaponAttachments 永远是空的，别去那里找
--   * 工厂 Skins.GetCharacterModel(武器名, "Stock") 返回的模型，零件名与尺寸
--     与远程玩家手里的枪完全一致（"Vanilla" 返回 nil，必须用 "Stock"）
-- 本实现：
--   1) 工厂造模型（优先用你配的皮肤，其次 Stock）→ 放 workspace.Debris.<你>_Weapon
--   2) 扫远程玩家的 RightHand，找零件名集合与我们的模型一致的枪 → 抄它的 C0/C1 与 Part0/Part1 角色
--   3) 抄不到（场上没人拿同款枪）→ 用滑块兜底偏移
-- 仅本机：客户端建立的实例不会复制给其他玩家
do

local TPW = getgenv().TPWeaponState
if type(TPW) ~= "table" then
	TPW = {}
	getgenv().TPWeaponState = TPW
end
for k, v in pairs({
	On = false,
	UseNative = true,
	Scale = 15,
	NoFactory = false,
	ForceFactory = false,
	PosX = 0, PosY = 0, PosZ = 0, RotX = 0, RotY = 0, RotZ = 0,
}) do
	if TPW[k] == nil then
		TPW[k] = v
	end
end

local tpModel, tpWeld, tpName, tpBuilt, tpErr, tpSrcTag = nil, nil, nil, 0, nil, nil

local function tpClear()
	if tpWeld then
		pcall(function() tpWeld:Destroy() end)
		tpWeld = nil
	end
	if tpModel then
		pcall(function() tpModel:Destroy() end)
		tpModel = nil
	end
	local box = workspace:FindFirstChild("Debris")
	box = box and box:FindFirstChild(LP.Name .. "_Weapon")
	if box then
		pcall(function() box:Destroy() end)
	end
	tpName, tpSrcTag = nil, nil
end

local function tpOffset()
	return CFrame.new(TPW.PosX, TPW.PosY, TPW.PosZ)
		* CFrame.Angles(math.rad(TPW.RotX), math.rad(TPW.RotY), math.rad(TPW.RotZ))
end

local function tpWeaponName()
	local cam = workspace.CurrentCamera
	if not cam then
		return nil
	end
	local best
	for _, m in ipairs(cam:GetChildren()) do
		if m:IsA("Model") and m:FindFirstChild("Weapon") then
			best = m.Name
		end
	end
	return best
end

local function tpSkinsLib()
	local node = RS
	for _, seg in ipairs({ "Database", "Components", "Libraries", "Skins" }) do
		node = node and node:FindFirstChild(seg)
	end
	if not (node and node:IsA("ModuleScript")) then
		return nil
	end
	local ok, lib = pcall(require, node)
	if ok and type(lib) == "table" and type(lib.GetCharacterModel) == "function" then
		return lib
	end
	return nil
end

local function tpCount(inst)
	local n = 0
	if inst:IsA("BasePart") then
		n += 1
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

-- 零件名集合指纹：用来判断「远程玩家手里的是不是同款枪」
local function tpKey(inst)
	local t = {}
	if inst:IsA("BasePart") then
		t[#t + 1] = inst.Name
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			t[#t + 1] = d.Name
		end
	end
	table.sort(t)
	return table.concat(t, ",")
end

-- 修剪：去掉相机 / 灯光 / 手部；拆掉指向模型外部的悬空关节
local function tpSanitize(mdl)
	local function inside(p)
		return p ~= nil and p:IsDescendantOf(mdl)
	end
	for _, d in ipairs(mdl:GetDescendants()) do
		if d:IsA("BasePart") and (d.Name == "Camera" or d.Name == "CameraPart"
			or d.Name == "Left Arm" or d.Name == "Right Arm" or d.Name == "Glove") then
			pcall(function() d:Destroy() end)
		elseif d:IsA("LuaSourceContainer") or d:IsA("Camera") or d:IsA("Light") then
			pcall(function() d:Destroy() end)
		end
	end
	for _, d in ipairs(mdl:GetDescendants()) do
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("Snap") then
			if not (inside(d.Part0) and inside(d.Part1)) then
				pcall(function() d:Destroy() end)
			end
		end
	end
	return tpCount(mdl) > 0
end

-- 造模型：工厂优先（NoFactory 时跳过），克隆兜底（ForceFactory 时跳过）
local function tpBuildModel(name)
	if not TPW.NoFactory then
		local lib = tpSkinsLib()
		if lib then
			local cfg = getgenv().SkinConfig
			local skin = (type(cfg) == "table" and type(cfg.GunSkins) == "table")
				and cfg.GunSkins[name] or nil
			local cands = {}
			if type(skin) == "string" and skin ~= "" then
				cands[#cands + 1] = skin
			end
			cands[#cands + 1] = "Stock"
			cands[#cands + 1] = "Vanilla"
			cands[#cands + 1] = ""
			for _, s in ipairs(cands) do
				local ok, m = pcall(lib.GetCharacterModel, name, s)
				if ok and typeof(m) == "Instance" and m:IsA("Model") then
					if tpSanitize(m) then
						tpSrcTag = "工厂(" .. tostring(s == "" and "无皮肤" or s) .. ")"
						return m
					end
					pcall(function() m:Destroy() end)
				end
			end
			tpErr = "工厂无可用模型"
		else
			tpErr = "工厂不可用"
		end
	end
	if not TPW.ForceFactory then
		local cam = workspace.CurrentCamera
		if cam then
			for _, mdl in ipairs(cam:GetChildren()) do
				if mdl:IsA("Model") and mdl.Name == name then
					local w = mdl:FindFirstChild("Weapon")
					if w and tpCount(w) > 0 then
						local ok, c = pcall(function()
							return w:Clone()
						end)
						if ok and c then
							pcall(function() c:ScaleTo(TPW.Scale) end)
							if tpSanitize(c) then
								tpSrcTag = "第一人称克隆 x" .. tostring(TPW.Scale)
								return c
							end
							pcall(function() c:Destroy() end)
						end
					end
				end
			end
		end
		tpErr = (tpErr and (tpErr .. " / ") or "") .. "克隆失败"
	end
	return nil
end

-- 抄远程玩家的焊点：要求零件名集合与我们的模型一致
local function tpFindNative(key)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then
			local char = plr.Character
			local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
			if hand and hand:IsA("BasePart") then
				for _, j in ipairs(hand:GetChildren()) do
					if j:IsA("JointInstance") then
						local a, b = j.Part0, j.Part1
						local other = (a == hand) and b or a
						local mdl = other and other.Parent
						if mdl and mdl:IsA("Model") and tpKey(mdl) == key then
							return {
								C0 = j.C0, C1 = j.C1,
								handIsPart0 = (a == hand),
								otherName = other.Name,
								from = plr.Name,
							}
						end
					end
				end
			end
		end
	end
	return nil
end

local function tpHasJoint(p)
	for _, j in ipairs(p:GetChildren()) do
		if j:IsA("JointInstance") or j:IsA("WeldConstraint") then
			return true
		end
	end
	return false
end

-- 整块移动模型（避免焊接前的一帧闪现在原点）
local function tpMove(mdl, main, target)
	local delta = target * main.CFrame:Inverse()
	for _, d in ipairs(mdl:GetDescendants()) do
		if d:IsA("BasePart") then
			pcall(function() d.CFrame = delta * d.CFrame end)
		end
	end
	pcall(function() main.CFrame = target end)
end

local function tpAttach(mdl, char, native)
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	if not (hand and hand:IsA("BasePart")) then
		tpErr = "找不到右手"
		return nil
	end
	local main
	if native then
		main = mdl:FindFirstChild(native.otherName)
	end
	if not (main and main:IsA("BasePart")) then
		main = mdl.PrimaryPart or mdl:FindFirstChild("Handle") or mdl:FindFirstChildWhichIsA("BasePart")
	end
	if not (main and main:IsA("BasePart")) then
		tpErr = "模型没有可用部件"
		return nil
	end
	mdl.PrimaryPart = main

	-- 放进 workspace.Debris.<你>_Weapon（与游戏一致，也让"角色外观"不去染枪）
	local holder = workspace:FindFirstChild("Debris")
	if not (holder and holder:IsA("Instance")) then
		holder = workspace
	end
	local box = holder:FindFirstChild(LP.Name .. "_Weapon")
	if not box then
		box = Instance.new("Model")
		box.Name = LP.Name .. "_Weapon"
		box.Parent = holder
	end
	mdl.Name = "Weapon"
	mdl.Parent = box

	for _, d in ipairs(mdl:GetDescendants()) do
		if d:IsA("BasePart") then
			pcall(function()
				d.Anchored = false
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				d.Massless = true
			end)
		end
	end
	-- 内部未焊的零件：按当前相对位置补焊到主部件
	for _, d in ipairs(mdl:GetDescendants()) do
		if d:IsA("BasePart") and d ~= main and not tpHasJoint(d) then
			local w = Instance.new("Weld")
			w.Name = "TP_AutoWeld"
			w.Part0 = main
			w.Part1 = d
			w.C0 = main.CFrame:Inverse() * d.CFrame
			w.C1 = CFrame.new()
			w.Parent = main
		end
	end

	local weld = Instance.new("Weld")
	weld.Name = "TP_HandWeld"
	if native then
		-- 照抄游戏的 C0/C1 与 Part0/Part1 角色
		if native.handIsPart0 then
			weld.Part0, weld.Part1 = hand, main
			tpMove(mdl, main, hand.CFrame * native.C0 * native.C1:Inverse())
		else
			weld.Part0, weld.Part1 = main, hand
			tpMove(mdl, main, hand.CFrame * native.C1 * native.C0:Inverse())
		end
		weld.C0, weld.C1 = native.C0, native.C1
	else
		weld.Part0, weld.Part1 = hand, main
		weld.C0, weld.C1 = tpOffset(), CFrame.new()
		tpMove(mdl, main, hand.CFrame * weld.C0)
	end
	weld.Parent = hand
	return weld
end

-- 驱动：0.1 秒检查；偏移实时生效；每 4 秒重建一次以跟随外观/皮肤颜色
task.spawn(function()
	while task.wait(0.1) do
		if Library.Unloaded then
			tpClear()
			return
		end
		local camState = getgenv().CameraState
		local wantOn = TPW.On and type(camState) == "table" and camState.TP == true
			and not isSpectating()
		if not wantOn then
			if tpModel then
				tpClear()
			end
		else
			local char = LP.Character
			local name = tpWeaponName()
			if not (char and char.Parent and name) then
				if tpModel then
					tpClear()
				end
			else
				local now = os.clock()
				local stale = (tpModel == nil) or (tpModel.Parent == nil)
					or (tpName ~= name) or (now - tpBuilt > 4)
				if stale then
					tpClear()
					local mdl = tpBuildModel(name)
					if mdl then
						local native
						if TPW.UseNative then
							native = tpFindNative(tpKey(mdl))
						end
						local ok, w = pcall(tpAttach, mdl, char, native)
						if ok and w then
							tpModel, tpWeld, tpName, tpBuilt = mdl, w, name, now
							tpErr = nil
							if native then
								tpSrcTag = (tpSrcTag or "") .. " + 抄自 " .. native.from
							else
								tpSrcTag = (tpSrcTag or "") .. " + 滑块兜底"
							end
						else
							pcall(function() mdl:Destroy() end)
						end
					end
				elseif tpWeld and tpWeld.Parent then
					if not TPW.UseNative then
						pcall(function()
							tpWeld.C0 = tpOffset()
						end)
					end
				end
			end
		end
	end
end)

