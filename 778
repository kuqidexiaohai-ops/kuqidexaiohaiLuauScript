--// ======================== 6.9 玩家 · 摄像机功能 ========================
do -- ★ 分节包裹

local CAMS = getgenv().CameraState
if type(CAMS) ~= "table" then
	CAMS = {}
	getgenv().CameraState = CAMS
end
for k, v in pairs({
	TP = false,
	Dist = 5.5,
	ShowHands = true,
	Occlude = true,
	Wide = 1.0,
	FOV = 70,
	HideHead = true,
}) do
	if CAMS[k] == nil then
		CAMS[k] = v
	end
end
CAMS.Height = nil
CAMS.FovBase = nil
CAMS.FovApplied = false
CAMS.FovHoldStart = nil

CAMS.minDistance = 2.0
CAMS.hideBelow = 2.5
CAMS.fpBelow = 1.5
CAMS.distLerp = 18
CAMS.occludePad = 0.35

-- ---------- LocalTransparencyModifier ----------
local ltmSaved, ltmWanted = {}, {}

local function camSetLTM(part, v)
	if v == nil then
		local orig = ltmSaved[part]
		if orig ~= nil then
			ltmSaved[part], ltmWanted[part] = nil, nil
			pcall(function()
				part.LocalTransparencyModifier = orig
			end)
		end
		return
	end
	if ltmWanted[part] == v then
		return
	end
	if ltmSaved[part] == nil then
		local ok, cur = pcall(function()
			return part.LocalTransparencyModifier
		end)
		ltmSaved[part] = ok and cur or 0
	end
	ltmWanted[part] = v
	pcall(function()
		if part.LocalTransparencyModifier ~= v then
			part.LocalTransparencyModifier = v
		end
	end)
end

local function camPruneLTM()
	for p in pairs(ltmWanted) do
		if p.Parent == nil then
			ltmWanted[p], ltmSaved[p] = nil, nil
		end
	end
end

local function camRestoreLTM()
	for part, v in pairs(ltmSaved) do
		pcall(function()
			part.LocalTransparencyModifier = v
		end)
	end
	ltmSaved, ltmWanted = {}, {}
end

-- ---------- 锚点 ----------
local function camAnchor()
	local char = LP.Character
	if not (char and char.Parent) then
		return nil, nil, nil
	end
	local cp = char:FindFirstChild("CameraPart")
	if cp and cp:IsA("BasePart") then
		return cp, cp.Position, char
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root, root.Position + Vector3.new(0, 1.85, 0), char
	end
	return nil, nil, char
end

-- ---------- 遮挡射线 ----------
local camRay = RaycastParams.new()
camRay.FilterType = Enum.RaycastFilterType.Exclude
camRay.IgnoreWater = true

local function camRefreshFilter(cam)
	local list = { cam }
	local f = workspace:FindFirstChild("Characters")
	if f then
		list[#list + 1] = f
	end
	camRay.FilterDescendantsInstances = list
end

-- ---------- 零件缓存 ----------
local camCache = { body = {}, vm = {}, vmNames = {}, t = -1 }

local function camRefreshCache(cam)
	local now = os.clock()
	if now - camCache.t < 0.1 then
		return
	end
	camCache.t = now

	camCache.body = {}
	local char = LP.Character
	if char then
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then
				camCache.body[#camCache.body + 1] = d
			end
		end
	end

	camCache.vm, camCache.vmNames = {}, {}
	for _, m in ipairs(cam:GetChildren()) do
		if m:IsA("Model") then
			local n = 0
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") then
					n += 1
					camCache.vm[#camCache.vm + 1] = d
				end
			end
			if n > 0 then
				camCache.vmNames[#camCache.vmNames + 1] = m.Name
			end
		end
	end
end

-- ---------- 正交基重建 ----------
local function camCleanRotation(r0)
	local rx = r0.RightVector
	local uy = r0.UpVector
	if rx.Magnitude < 0.5 or uy.Magnitude < 0.5 then
		return r0
	end
	return CFrame.fromMatrix(Vector3.zero, rx.Unit, uy.Unit)
end

-- ---------- 真·广角（FOV）----------
local fovHookCam, fovHookConn = nil, nil

local function camEnsureFovHook(cam)
	if fovHookCam == cam and fovHookConn then
		return
	end
	if fovHookConn then
		pcall(function()
			fovHookConn:Disconnect()
		end)
	end
	fovHookCam = cam
	fovHookConn = cam:GetPropertyChangedSignal("FieldOfView"):Connect(function()
		local v = cam.FieldOfView
		if CAMS.FOV > 70.01 and math.abs(v - CAMS.FOV) < 0.01 then
			return
		end
		if CAMS.FovBase == nil or v > CAMS.FovBase + 0.5 then
			CAMS.FovBase = v
		end
	end)
end

local function camRestoreFOV()
	if not CAMS.FovApplied then
		return
	end
	CAMS.FovApplied = false
	local cam = workspace.CurrentCamera
	if cam and CAMS.FovBase then
		pcall(function()
			cam.FieldOfView = CAMS.FovBase
		end)
	end
end

local function camStepFOV(cam)
	if CAMS.FOV <= 70.01 then
		camRestoreFOV()
		return
	end
	camEnsureFovHook(cam)
	local cur = cam.FieldOfView
	local base = CAMS.FovBase or cur
	local holding = cur < base - 1
	if holding then
		CAMS.FovHoldStart = CAMS.FovHoldStart or os.clock()
		if os.clock() - CAMS.FovHoldStart > 3 then
			CAMS.FovBase = cur
			CAMS.FovHoldStart = nil
		end
	else
		CAMS.FovHoldStart = nil
		if math.abs(cur - CAMS.FOV) > 0.01 then
			pcall(function()
				cam.FieldOfView = CAMS.FOV
			end)
		end
		CAMS.FovApplied = true
	end
end

-- ---------- 主循环 ----------
local CAM_BIND = "BeautifyCameraFunction"
pcall(function()
	RunService:UnbindFromRenderStep(CAM_BIND)
end)

local camBound = false
local camCurDist = CAMS.Dist
local camSetBound

local function camStep(dt)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	-- ★ v22：观战时让行（不写相机），退出观战自动恢复
	local wantTP = CAMS.TP and not isSpectating()
	local wantWide = math.abs((CAMS.Wide or 1) - 1) > 0.001
	local wantFOV = CAMS.FOV > 70.01
	if not wantTP and not wantWide and not wantFOV then
		return
	end

	local ok, err = pcall(function()
		local rot = camCleanRotation(cam.CFrame.Rotation)
		local baseCf = CFrame.new(cam.CFrame.Position) * rot

		if wantTP then
			camRefreshCache(cam)
			camPruneLTM()

			local cp, anchorPos, char = camAnchor()
			if not cp then
				camRestoreLTM()
				return
			end

			local look = rot.LookVector

			local want = CAMS.Dist
			if CAMS.Occlude and want > 0.01 then
				camRefreshFilter(cam)
				local hit = workspace:Raycast(anchorPos, -look * want, camRay)
				if hit then
					want = math.max(CAMS.minDistance,
						math.min(want, (hit.Position - anchorPos).Magnitude - CAMS.occludePad))
				end
			end

			local k = math.min(1, math.max(0, (dt or 1 / 60) * CAMS.distLerp))
			camCurDist += (want - camCurDist) * k
			if math.abs(camCurDist - want) < 0.01 then
				camCurDist = want
			end

			local p = anchorPos - look * camCurDist
			baseCf = CFrame.new(p) * rot

			local head = char and char:FindFirstChild("Head")
			local fp = camCurDist < CAMS.fpBelow
			for _, d in ipairs(camCache.body) do
				if d.Parent and d.Transparency < 1 then
					local v = 0
					if fp or (d == head and CAMS.HideHead and camCurDist < CAMS.hideBelow) then
						v = 1
					end
					camSetLTM(d, v)
				end
			end

			local hasWeapon = #camCache.vmNames > 0
			local showVM
			if fp then
				showVM = true
			elseif CAMS.ShowHands then
				showVM = hasWeapon
			else
				showVM = false
			end
			for _, d in ipairs(camCache.vm) do
				if d.Parent and d.Transparency < 1 then
					camSetLTM(d, (showVM and 0) or 1)
				end
			end
		elseif next(ltmSaved) then
			camRestoreLTM()
		end

		if wantWide then
			baseCf = baseCf * CFrame.new(0, 0, 0, 1, 0, 0, 0, CAMS.Wide, 0, 0, 0, 1)
		end

		if wantTP or wantWide then
			cam.CFrame = baseCf
		end

		camStepFOV(cam)
	end)

	if not ok then
		warn("[摄像机功能] 运行出错，已自动关闭：" .. tostring(err))
		CAMS.TP = false
		CAMS.Wide = 1
		CAMS.FOV = 70
		camRestoreLTM()
		camRestoreFOV()
		camSetBound(false)
	end
end

camSetBound = function(on)
	if on and not camBound then
		camBound = true
		camCurDist = CAMS.Dist
		pcall(function()
			RunService:BindToRenderStep(CAM_BIND, Enum.RenderPriority.Last.Value, camStep)
		end)
	elseif not on and camBound then
		camBound = false
		pcall(function()
			RunService:UnbindFromRenderStep(CAM_BIND)
		end)
	end
end

local function camActive()
	return CAMS.TP
		or math.abs((CAMS.Wide or 1) - 1) > 0.001
		or CAMS.FOV > 70.01
end

local function camSync()
	camSetBound(camActive())
	if not camActive() then
		camRestoreLTM()
		camRestoreFOV()
	end
end

getgenv().CameraCleanup = function()
	CAMS.TP = false
	CAMS.Wide = 1
	CAMS.FOV = 70
	camSetBound(false)
	camRestoreLTM()
	camRestoreFOV()
	CAMS.FovBase = nil
	CAMS.FovHoldStart = nil
end

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	if camActive() then
		camSync()
	end
end)
LP.CharacterAdded:Connect(function()
	task.delay(0.3, function()
		if camActive() then
			camSync()
		end
	end)
end)

