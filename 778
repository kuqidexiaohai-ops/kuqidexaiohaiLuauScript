local function restorePreviousSessionHooks()
	local store = getgenv().SkinHookStore
	if type(store) ~= "table" then return end
	for i = #store, 1, -1 do
		local h = store[i]
		pcall(function()
			if type(h) == "table" and type(h.module) == "table" and type(h.orig) == "function" and h.funcName then
				h.module[h.funcName] = h.orig
			end
		end)
		store[i] = nil
	end
	getgenv().SkinHookStore = nil
end

local function addHook(module, funcName, makeWrapper)
	if type(module) ~= "table" or type(module[funcName]) ~= "function" then
		return false
	end
	local orig = module[funcName]
	local entry = { module = module, funcName = funcName, orig = orig }
	table.insert(HookRegistry, entry)
	local store = getgenv().SkinHookStore
	if type(store) ~= "table" then
		store = {}
		getgenv().SkinHookStore = store
	end
	table.insert(store, entry)
	module[funcName] = makeWrapper(orig)
	return true
end

local function removeAllHooks()
	for i = #HookRegistry, 1, -1 do
		local h = HookRegistry[i]
		pcall(function() h.module[h.funcName] = h.orig end)
