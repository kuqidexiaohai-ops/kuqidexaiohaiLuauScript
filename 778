local foreignScope = 0

local function detectOwnerContext(...)
	local foundLocal, foundForeign = false, false
	local args = table.pack(...)
	local ownChar = LP.Character

	local function classify(v)
		if typeof(v) ~= "Instance" then return end
		if v == LP then foundLocal = true; return end
		if v:IsA("Player") then
			if v == LP then foundLocal = true else foundForeign = true end
			return
		end
		if ownChar and v:IsDescendantOf(ownChar) then foundLocal = true; return end
		local plr = Players:GetPlayerFromCharacter(v)
		if plr then
			if plr == LP then foundLocal = true else foundForeign = true end
			return
		end
		local anc = v.Parent
		for _ = 1, 6 do
			if not anc or anc == game then break end
			if anc == LP or (ownChar and anc == ownChar) then foundLocal = true; return end
			local ap = Players:GetPlayerFromCharacter(anc)
			if ap then
				if ap == LP then foundLocal = true else foundForeign = true end
				return
			end
			anc = anc.Parent
		end
	end

	for i = 1, args.n do
		classify(args[i])
		if foundForeign then break end
	end

	if foundForeign then return "foreign" end
	if foundLocal then return "local" end
	return nil
end

local function detectSelfOwner(self)
	local cands = {}
	if typeof(self) == "Instance" then
		table.insert(cands, self)
	elseif type(self) == "table" then
		for _, key in ipairs({ "Player", "Character", "Owner", "Humanoid" }) do
			local v = self[key]
			if v ~= nil then table.insert(cands, v) end
		end
	end
	if #cands == 0 then return nil end
	return detectOwnerContext(table.unpack(cands))
end

