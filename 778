local function getWearFolder(root, weaponName, skinName, wear)
	local wf = root:FindFirstChild(weaponName)
	local sf = wf and wf:FindFirstChild(skinName)
	local cam = sf and sf:FindFirstChild("Camera")
	if not cam then return nil end
	return cam:FindFirstChild(wear or "Factory New") or cam:FindFirstChild("Factory New")
