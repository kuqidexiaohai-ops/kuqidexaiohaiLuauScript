--// ======================== 6.10 世界 · 滤镜（本机） ========================
do

local Lighting = game:GetService("Lighting")

local WorldOrig = getgenv().WorldOrig
if type(WorldOrig) ~= "table" then
	local atm0 = Lighting:FindFirstChildOfClass("Atmosphere")
	WorldOrig = {
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		ExposureCompensation = Lighting.ExposureCompensation,
		Brightness = Lighting.Brightness,
		ClockTime = Lighting.ClockTime,
		AtmHaze = atm0 and atm0.Haze or 0,
		AtmGlare = atm0 and atm0.Glare or 0,
		AtmColor = atm0 and atm0.Color or nil,
		AtmDecay = atm0 and atm0.Decay or nil,
		HadAtmosphere = atm0 ~= nil,
		CreatedAtm = false,
	}
	getgenv().WorldOrig = WorldOrig
else
	pcall(function()
		Lighting.Ambient = WorldOrig.Ambient
		Lighting.OutdoorAmbient = WorldOrig.OutdoorAmbient
		Lighting.ExposureCompensation = WorldOrig.ExposureCompensation
		Lighting.Brightness = WorldOrig.Brightness
		Lighting.ClockTime = WorldOrig.ClockTime
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm then
			atm.Haze = WorldOrig.AtmHaze or 0
			atm.Glare = WorldOrig.AtmGlare or 0
			if WorldOrig.AtmColor then atm.Color = WorldOrig.AtmColor end
			if WorldOrig.AtmDecay then atm.Decay = WorldOrig.AtmDecay end
		end
		if WorldOrig.CreatedAtm and not WorldOrig.HadAtmosphere then
			local a = Lighting:FindFirstChildOfClass("Atmosphere")
			if a then a:Destroy() end
			WorldOrig.CreatedAtm = false
		end
	end)
end

local WS = getgenv().WorldState
if type(WS) ~= "table" then
	WS = {}
	getgenv().WorldState = WS
end
for k, v in pairs({
	AmbIn = false, AmbInColor = Color3.fromRGB(100, 155, 255),
	AmbOut = false, AmbOutColor = Color3.fromRGB(100, 155, 255),
	Haze = false, HazeColor = Color3.fromRGB(141, 255, 60), HazeStrength = 1.5,
	Glare = false, GlareColor = Color3.fromRGB(100, 155, 255), GlareStrength = 1.4,
	Exposure = false, ExposureValue = 0,
	Brightness = false, BrightnessValue = WorldOrig.Brightness,
	Clock = false, ClockValue = WorldOrig.ClockTime,
}) do
	if WS[k] == nil then
		WS[k] = v
	end
end

local function worldAtm()
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if atm then
		return atm
	end
	local ok, new = pcall(function()
		local a = Instance.new("Atmosphere")
		a.Parent = Lighting
		return a
	end)
	if ok and new then
		WorldOrig.CreatedAtm = true
		return new
	end
	return nil
end

local function worldApply()
	pcall(function()
		Lighting.Ambient = WS.AmbIn and WS.AmbInColor or WorldOrig.Ambient
		Lighting.OutdoorAmbient = WS.AmbOut and WS.AmbOutColor or WorldOrig.OutdoorAmbient
		Lighting.ExposureCompensation = WS.Exposure and WS.ExposureValue or WorldOrig.ExposureCompensation
		Lighting.Brightness = WS.Brightness and WS.BrightnessValue or WorldOrig.Brightness
		Lighting.ClockTime = WS.Clock and WS.ClockValue or WorldOrig.ClockTime

		local atm = (WS.Haze or WS.Glare) and worldAtm() or Lighting:FindFirstChildOfClass("Atmosphere")
		if not atm then
			return
		end
		if WS.Haze then
			atm.Haze = WS.HazeStrength
			atm.Color = WS.HazeColor
		else
			atm.Haze = WorldOrig.AtmHaze or 0
			if WorldOrig.AtmColor then atm.Color = WorldOrig.AtmColor end
		end
		if WS.Glare then
			atm.Glare = WS.GlareStrength
			atm.Decay = WS.GlareColor
		else
			atm.Glare = WorldOrig.AtmGlare or 0
			if WorldOrig.AtmDecay then atm.Decay = WorldOrig.AtmDecay end
		end
		if not (WS.Haze or WS.Glare) and WorldOrig.CreatedAtm then
			pcall(function()
				atm:Destroy()
			end)
			WorldOrig.CreatedAtm = false
		end
	end)
end

local function worldAnyOn()
	return WS.AmbIn or WS.AmbOut or WS.Haze or WS.Glare
		or WS.Exposure or WS.Brightness or WS.Clock
end

getgenv().WorldReport = function()
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	print(("[世界] 室内光=%s 室外光=%s 雾=%s 眩光=%s 曝光=%s 亮度=%s 时间=%s"):format(
		tostring(WS.AmbIn), tostring(WS.AmbOut), tostring(WS.Haze), tostring(WS.Glare),
		tostring(WS.Exposure), tostring(WS.Brightness), tostring(WS.Clock)))
	print(("[世界] Ambient=%s Outdoor=%s 曝光=%.2f 亮度=%.2f 时间=%.2f | Atmosphere=%s"):format(
		tostring(Lighting.Ambient), tostring(Lighting.OutdoorAmbient),
		Lighting.ExposureCompensation, Lighting.Brightness, Lighting.ClockTime,
		atm and ("Haze=%.2f Glare=%.2f"):format(atm.Haze, atm.Glare) or "无"))
