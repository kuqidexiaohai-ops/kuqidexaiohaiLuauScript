			end
			Catalog.GloveTypeEntries[gtype] = list
		end
	end

	for _, cat in ipairs(CATEGORIES) do
		local entries = {
			{
				kind = "gun", name = "默认", label = cat.weapon .. " | 默认",
				id = nil, isDefault = true,
				weapon = cat.weapon, skin = "", wear = "Factory New",
			},
		}
		local skins = collectSkinEntries(cat.weapon, attr and attr[cat.weapon], FALLBACK_GUNS[cat.weapon], SKIP_GUN_SKINS)
		for _, s in ipairs(skins) do
			table.insert(entries, { kind = "gun", name = s.name, label = cat.weapon .. " | " .. s.name, id = s.id or cat.icon, isDefault = false, weapon = cat.weapon, skin = s.name, wear = "Factory New" })
		end
		Catalog.GunEntries[cat.id] = entries
	end
end

