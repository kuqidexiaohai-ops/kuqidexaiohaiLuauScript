local function patchWeaponModel(viewmodel, weaponName, skinName, wear)
	pcall(function()
		if not viewmodel or not viewmodel.Parent then return end
		if type(skinName) ~= "string" or skinName == "" or skinName == "Vanilla" then return end
		local tag = tostring(weaponName) .. "|" .. skinName
		if viewmodel:GetAttribute("SkinApplied") == tag then return end
		local root = getAssetsRoot()
		if not root then return end
		local wearFolder = getWearFolder(root, weaponName, skinName, wear)
		if not wearFolder then return end
		local target = viewmodel:FindFirstChild("Weapon") or viewmodel
		for _, part in ipairs(target:GetDescendants()) do
			if part:IsA("BasePart") then
				local template = wearFolder:FindFirstChild(part.Name)
				if template then
					local old = part:FindFirstChildOfClass("SurfaceAppearance")
					if old then old:Destroy() end
					local clone = template:Clone()
					clone.Name = "SurfaceAppearance"
					clone.Parent = part
				end
			end
		end
		viewmodel:SetAttribute("SkinApplied", tag)
	end)
end

