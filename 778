local function isSpectating()
	local cam = workspace.CurrentCamera
	if not cam then
		return false
	end
	local sub = cam.CameraSubject
	if not sub then
		return false
	end
	if sub:IsA("Humanoid") then
		local char = sub.Parent
		if char and char:IsA("Model") then
			local owner = Players:GetPlayerFromCharacter(char)
			if owner and owner ~= LP then
				return true
			end
		end
	end
	return false
end

